CompileFlags:
  Add:
    - -target
    - x86_64-unknown-linux-gnu
    # - x86_64-pc-windows-gnu
    - -I.
    - -fno-builtin
    - -Wall
    - -Wextra
    - -Wshadow
    - -Wconversion
    - -Wsign-conversion
    - -Wno-unused-includes
    - -fno-delete-null-pointer-checks
Diagnostics:
  UnusedIncludes: Ignore
