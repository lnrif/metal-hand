std := @mod("std.rk");

print := {} -> {} <| {};

m: ?usz.nonmax  = ...;
m: ?usz.nonzero = ...;

(ok, num) := m.items();

extern: fn(abi: .c) <| (x: f32) -> (y: f32);

find '= (
	ptr: uptr,
	len: usz,
) -> (
	ok: bool,
	at: usz,
) :: {
	(at'mut, end') = (ptr, ptr + len);
	while at != end then {
		if at.* == 0 ret (true, at - ptr);
		at += 1;
	};
	ret (false, usz.MAX);
};

f '= (T: type) -> T :: {
	@at(.stack) temporary'mut: T = ---;
	
	loop {
		@at(.reg) x'mut: usz = 0;
	} :: {
		x += 1;
		std.print("f({0}) => {1}\n", x, x * x);
		if x == 10 break;
	};

	ret T;
};

@main := () :: {
	x: usz'mut = 0;
	
	loop {
		x += 1;
		std.print("f({0}) => {1}\n", x, x * x);
		if x == 10 break;
	};
};

Bump := struct {
	low: *[?]u8,
	pos: *[?]u8,
	top: *[?]u8,
};

Env := struct {
	file: File,
	gravity: f32 = 9.8,
	fps: f32 = 60.0,
};

Layout '= struct(size: usz, aling: usz);

// Take the Risk, enjoy the speed
