Atom := enum {
	Tree { t: Tree },
	Token { t: Token },
};

Tree := struct {
	len: u32,
	tag: Tree.Tag,
};

Block := struct(:abi = .c) { ptr: uptr, len: usz };

reserve := (len: u64) -> Block => @todo();

Tree <| module {
	# Tag => enum { :Tag = u8; ... };
	Tag := enum(:Tag = u8) {
		# '(...)'
		paren,
		# '{...}'
		brace,
		# '[...]'
		brack,
	};
};

Token := struct(:align = u64.@align) {
	pos: u32,
	len: u24,
	tag: Token.Tag,
};


# @assert(:comptime, Token.@layout == u64.@layout, "...");
@assert(:comptime, Token.@size == u64.@size && Token.@align == u64.@align, "...");

Token <| module {
	Tag => enum(
		:Tag = u8,
	) {
		eof,
		number,
		ident,
		plus,
		minus,
		star,
		slash,
	};
};

f := (a: f64) -> (b: f64) => 2.0 * a;

g := (x: u32) -> u32 => f'{
	y := _'{ ret'_ x; };
	ret'f y;
};

std := @load("std.rk", :ty = .risk); # ty: enum { risk, bytes } = .risk;

main := () => {
	std.print("Hello, World!");
};
