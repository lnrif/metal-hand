Atom => enum {
	tree { t: Tree },
	token { t: Token },
};

Tree => struct {
	len: u32,
	tag: Tree.Tag,
};

Block => struct { ptr: uptr, len: usz };

reserve => proc { len: u64 } -> Block :: {};

Tree <| {
	# Tag => enum { :Tag = u8; ... };
	Tag => enum(:tag = u8) {
		# '(...)'
		paren,
		# '{...}'
		brace,
		# '[...]'
		brack,
	};
};

Token => struct {
	pos: u32,
	len: u24,
	tag: Token.Tag,
};

Token <| {
	Tag => enum(
		:Tag = u8,
	) {
		eof,
		number,
		ident,
		plus,
		minus,
		star,
		slash,
	};
};

