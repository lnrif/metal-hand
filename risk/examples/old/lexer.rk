:config = fn(x: f32) f32 do 2 * x;
:config = fn(x: f32) f32 do 2 * x;

for @it := 1..=10 do print(@it);

Lexer |=| type {
	peek <| (&self) -> u8 => self.src[0];

	skip <| (&'mut self) -> u8 => {
		(src, peek) <~ self.(src, peek);
		b := peek();
		if b != 0 then src = &src[1..];
		ret b;
	};

	next <| (&'mut self) -> Token => {
		(peek, skip) <~ self.(peek, skip);
		while peek() == " " do skip();
		
		done := (token: Token) -> @code(.expand) => { skip(); ret token; };
		
		peek() match {
			"+" => done(.plus),
"-" => done(.minus),
			"*" => done(.mul),
			"/" => done(.div),
			"(" => done(.open.paren),
			")" => done(.close.paren),
			"0"..="9" => done(.int);
			"\0" => ret .eof;
			else => ret .ill;
		};
	};
};

expr => (lex: &'mut Lexer) -> (val: i32, ok: u1) :: {
	left := factor(lex);
	if !left.ok ret (0, 0);

	while lex.peek() == "+" or lex.peek() == "-" {
		op := lex.next();
		right := factor(lex);
		if !right.ok ret (0, 0);
		left := if op == .plus
			then (left.val + right.val, 1)
			else (left.val - right.val, 1);
	};
	ret left;
};

factor => {
	lex: &'mut Lexer,
} -> {
	val: i32,
	ok: u1,
} :: {
	tok := lex.next();
	if tok == .int ret (parse_int(lex), 1);
	if tok == .lparen {
		result := expr(lex);
		if lex.next() != .rparen ret (0, 0);
		ret result;
	};
	ret (0, 0);
};

STACK_MAX: u64 => 0;

main => () -> void :: {
	input := "2 + 3 * (4 - 1)";
	lexer'mut = Lexer { src: &input, pos: 0 };
	result := expr(&lexer);
	if result.ok then std.print("= {0}\n", result.val)
	else std.print("error\n");
};

extern'once: u32 = ---;

@entry'once: ?() -> !ret = null;

std := @load("std.rk");
