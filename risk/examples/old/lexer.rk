Token => enum { :Tag = u8;
	eof;
	ill;
	int;
	plus; minus; mul; div;
	open.{paren};
	close.{paren};
};

Token => enum { :Tag = u8;
	eof, ill,
	str, int, id,
	plus, minus, star, slash,
	open.{paren, brace, bracket},
	close.{paren, brace, bracket},
};

add => { a: f32, b: f32 } -> { c: f32 } :: a + b;

Lexer => struct { src: &[?:0]u8 };

X enum {};

Tag => enum(u8) {};

add => () :: a + b;

