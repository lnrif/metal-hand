Exit => (code: i32) -> !ret;
exit => @extern(:name = "exit", :ty = Exit);

Vec => mod {
	@call => { T: type = @infer } -> { V: type } :: {
		V => struct { ptr: &'mut T, len: u64, cap: u64 };

		V <| mod {
			push => (v: &'mut V) -> () :: {
				...
			};
		};

		ret V;
	};
};

add => { a, b: T; T := @infer(type) } -> { c: T } :: a + b;

|main := () -> !ret :: {
	
	x := '_: {
		x'mut := 0;
		loop {
			x += 1;
			if x == 10 ret'_;
		};
	};
};
