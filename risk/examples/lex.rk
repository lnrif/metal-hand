|> Token := struct(
	repr: .c,
	align: 8,
) {
	len: u8,
	kind: Kind,
};

|> Kind := enum(
	repr: u8,
) {
	eof, ill,
	id, str, int,
	plus, minus,
};

|> relu := type {
	|> FACTOR := 0.01;
	
	|> call := (x: f32) -> f32 {
		ret if x > 0.0 then x else x * FACTOR;
	};
	
	|> deriv := (x: f32) -> f32 {
		ret if x > 0.0 then 1.0 else FACTOR;
	};
};

|Lexer := struct { pos: &[?]u8; };

|Os   := enum { linux, windows };
|Arch := enum { x86-64, arm-64 };

T := '_: {
	A := Region-Args;
	ret'_ A;
};

player.health -= enemy.damage;

compile_linux := { ... } -> { ... } :: ...;
compile_impl  := { os: Os; arch: Arch } -> {} :: {};

|x := ;

f := { x, y, z: f32; a: u8 } -> f64 :: x.(f64) * y.(f64) * z.(f64) + a.(f64);

lex := {
	src'mut: &[?:0]u8;
} -> {
	lexer: Lexer;
} :: {
	
};

.lex := (src'mut: &[64]u8) -> Kind {
	peek := fn {src := src} -> u8 :: src[0];

	skip := () -> u8 {
		b := peek!;
		if b != 0 then src = &src[1..];
		ret b;
	};

	eat := (b: u8) -> bool {
		if peek() != b ret false;
		skip(); ret true;
	};

	match peek() {
		
	};

	if eat("-") {
		if eat("=") ret .minus_eq;
		ret .minus;
	};

	if eat("+") {
		if eat("=") ret .plus_eq;
		ret .plus;
	};

	ret .ill;
};
