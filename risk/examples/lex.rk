};

Tag => enum {
	eof, illegal,
	number, ident,
	plus, minus, star,
};

tag: Tag = ---;

if tag {
	.eof ret,
	.illegal do @panic(...),
	.number or .ident do ...,
	.plus or .minus or .star do ...,
};
