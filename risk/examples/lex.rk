Token => struct { pos: u32, len: u24, tag: Tag };

next => proc { lexer: &Lexer'mut } -> { token: Token } :: {
	token'mut { pos, len, tag } := Token { pos: 10, len: 1, tag: .number };
	ret token;
};


lex => proc { src'mut: &[64]u8 } -> { kind: Kind } :: {
	peek => proc { s := src } -> u8 :: src[0];

	skip => proc {} -> u8 {
		b := peek!;
		if b != 0 then src = &src[1..];
		ret b;
	};

	eat => proc { b: u8 } -> bool {
		if peek() != b ret false;
		skip(); ret true;
	};

	if peek() {
		a do ...,
		b do ...,
		else ...,
	};

	if a do b else c;

	# ИЛИ

	if peek() {
		a do ...,
		b do ...,
		else ...,
	};

	if a do b else c;

	if eat("-") {
		if eat("=") ret .minus_eq;
		ret .minus;
	};

	if eat("+") {
		if eat("=") ret .plus_eq;
		ret .plus;
	};

	ret .ill;
};

fun => proc { case: @expr } -> @code(:expand) :: {
	if cond {
		a do b,
		case do c,
		else d,
	};
};

Tag => enum { a, b, c, d };

