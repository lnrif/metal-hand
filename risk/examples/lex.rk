Token => struct(:repr = .c, :align = 8) { len: u8, kind: Kind };
Kind => enum(:repr = u8) { eof, ill, id, str, int, plus, minus };

relu => type {
	FACTOR => f16.{0.01};

	call => proc { x: f16 } -> f16 :: {
		ret if x > 0.0 do x else x * FACTOR;
	};

	deriv => proc { x: f16 } -> f16 :: {
		ret if x > 0.0 do 1.0 else FACTOR;
	};
};

Lexer => struct { pos: &[?]u8; };

Os   => enum { linux, windows };
Arch => enum { x86-64, arm-64 };

ASM => "test rax, rax" ++ "\n";

T := '_: {
	A => Region-Args;
	ret'_ A;
};

player.health -= enemy.damage;

compile_linux := proc { ... } -> { ... } :: ...;
compile_impl  := proc { os: Os; arch: Arch } -> {} :: {};

f => proc { x: f64, y: f64, z: f64, a: u8 } -> { b: f64 } :: f64.{x} * f64.{y} * f64.{z} + f64.{a};

lex => proc { src'mut: &[128:0]u8 } -> { lexer: Lexer } :: @todo();

