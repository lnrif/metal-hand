For := struct {
	beg: usz,
	end: usz,
	step: usz,
};

For <| type {
	short := (end: usz, step: usz = 1) :: {
		ret for { beg: 0, end, step };
	};

	full := (beg: usz, end: usz, step: usz = 1) :: {
		ret for { beg, end, step };
	};
};

For <| type {
	Body := (i: usz) -> ();
};

For <| impl {
	@call := (self, body: Body) -> () :: {
		loop {
			i'mut := self.beg;
		} :: {
			if i == self.end break;
			defer i += self.step;
			body(i, :@label = .outer);
		};
	};
};

for: fn {
	(          end: usz, step: usz = 1) -> For,
	(beg: usz, end: usz, step: usz = 1) -> For,
} = fn {
	For.short,
	For.full,
};

