Counter := (limit: usz = 10) -> mod :: mod {
	value: usz = 0;

	next := () -> ?usz :: {
		if value == limit ret null;
		defer value += 1;
		ret value; # 0, 1, 2, ...
	};

	peek := () -> usz :: value;
};

