# T'const is default mutability, defined by default:
Config'const => Config { file'const, data'const };

# T'mut defined by default
Config'mut => Config { file'mut, data'mut };

# you can change different fields mutability:
# Config'mut = Config { file, data'mut };
# Config'mut = Config { file, data };
# and exclude fields at all:
# Config'mut = Config { data };

# You can define custom mutability:
Config'file => Config { file'mut, data'const };

# Config'mut -> &'mut Config (not &Config'mut)
# Config'const -> &'const Config -> &Config (not &Config'const)

