sum := @run for @numbers :: |Num| {
	[]Num <| impl {
		sum := (&self) -> u32 {
			acc'mut := 0; for arr :: acc += it; ret acc;
		};
	};
};

sum := @run {
	for types:
	loop {
		idx'mut := 0;
		types   := .[u8];
		fns'mut := any.[];
	} :: {
		if idx == types.len ret fn.overload(fns);
		T := types[idx];
		f := (arr: &'const []) -> u32 {
			if arr.len == 0 ret 0;
			loop {
				i  'mut = 0;
				acc'mut = 0;
			} :: {
				acc += arr[i]; i += 1;
				if arr.len == i ret acc;
			};
		};
		fns.push(f);
		idx += 1;
	};
};

sum := @run {
	loop {
		idx'mut := 0;
		types   := .[u8];
		fns'mut := any.[];
	} :: {
		if idx == types.len ret fn.overload(fns);
		T := types[idx];
		f := (arr: &'const []) -> u32 {
			if arr.len == 0 ret 0;
			loop {
				i  'mut = 0;
				acc'mut = 0;
			} :: {
				acc += arr[i]; i += 1;
				if arr.len == i ret acc;
			};
		};
		fns.push(f);
		idx += 1;
	};
};

