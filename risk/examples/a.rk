f := fn {x: f32} -> f32 :: 2.0 * x + 1.0;

Function := fn { align: 32, abi: .win64, inline: .never };

function := Function(
	x: f32, y: f32, c: bool,
	@unused r: uptr,
	@unused p: &'mut [16]u8,
) -> (
	ok: bool,
	result: usz,
	optional: ?u8,
) :: {
	# stage 1
	w := if c then 2.0 * x + 1.0 else 3.0 * y;
	if w < 10.0 ret (false, .MAX, null);
	# stage 2
	i'mut = 0;
	z := loop'a: {
		i += 1;
		if i > w break'a i;
	};
	ret (true, z, @trunc(u8, w));
};

{ok, result, _} := function(
	.x = 10.0,
	.y = -7.0,
	.c = false,
	.r = uptr.null,
);

(ok, result, _) := function(x: 10.0, y: -7.0, c: false, r: uptr.null, &'mut .{0} * _);

