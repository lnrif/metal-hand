fib := (n: u64) -> u64 :: {
	if n < 2 ret n;
	(a, b, c)'mut = (0, 1, n - 1);
	loop {
		(a, b, c) = (b, a + b, c - 1);
		if c == 0 ret b;
	};
};

Mode := enum { comptime, runtime };

Builder := (mode: Mode) -> type :: {
	time := if mode == .comptime then @comptime else @dummy;
	ret struct {
		name: &[:0]u8 = "Unknown",
		health: f32 = 20.0,
		@apply(time) have_name:   bool = false,
		@apply(time) have_health: bool = false,
		@comptime mode: Mode = mode,
	};
};

Builder <| type {
	set_name := (builder: &'mut Builder, name: &[..]u8) -> &'mut Builder :: {
		builder.name = name;
		builder.have_name = true;
		ret builder;
	};

	set_health := (builder'mut: &'mut Builder, health: f32) -> &'mut Builder :: {
		builder.health = health;
		builder.have_health = true;
		ret builder;
	};
};

Builder <| type {
	can_build := (builder: &Builder) -> bool :: {
		ret builder.have_name() && builder.have_health;
	};
};

Builder <| type {
	@drop build := (builder: Builder) -> Player :: {
		if builder.can_build() ret Player {
			name: builder.name,
			health: builder.health,
		};

		@error("not enough fields for player building!");
		if !builder.have_name   then @print(" - expected name   (use [set_name])");
		if !builder.have_health then @print(" - expected health (use [set_health])");
		@abort();
	};
};

