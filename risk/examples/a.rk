Bump => struct { beg, pos, end: uptr };

Bump <| impl {
	init => proc { from_slice, from_bounds };

	from_slice := (slice: &'mut []u8) -> Bump :: {
		(beg, end) := slice.{beg(), end()};
		ret Bump { :beg = beg, :end = end };
	};

	from_bounds := (beg, end: uptr) -> Bump :: {
		@assert(beg <= end, "invalid bounds, expected that [beg] <= [end]");
		@assert(beg != 0 || (beg == 0 && end == 0), "invalid [slice]");
		ret Bump { :beg = beg, :pos = beg, :end = end };
	};
};

