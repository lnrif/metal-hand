Money := struct { get: usz };
# by default:
# - Money'mut   .= Money { get'mut };
# - Money'const .= Money { get }; # Money'const == Money

Money <| {
	inc := (m: &'mut Money) => {
		# m.*.get += 1;
		m.get += 1;
	};
};

Money <| Number(Money) {
	add => fn { a: Money, b: Money } -> Money :: Money { get: a.get +! b.get },
	sub => fn { a: Money, b: Money } -> Money :: Money { get: a.get -! b.get },
};

@main => {} :: {
	a := Money { get: 40 };
	b'mut = Money { get: 50 };
	# Number.add(a, b) == Money.add(a, b) == .add(a, b) == a.add(b)
	b = .add(a, b);
};



Vec3 := struct { x: f32, y: f32, z: f32 };
Vec2 := struct { x: f32, y: f32 };

Vec3 <| type {
	xy := (v: Vec3) -> Vec2 :: .{ x: v.x, y: v.y };
	yx := (v: Vec3) -> Vec2 :: .{ x: v.y, y: v.x };
	xyz := (v: Vec3) -> Vec3 :: .{ x: v.x, y: v.y, z: v.z };
};

DECIMAL_LEN := @tranc(usz, @lg(usz.MAX)) + 1;

usz_as_decimal := (
	x'mut: usz @assoc[as_decimal],
	buf: &'mut [DECIMAL_LEN]u8,
) -> (len: usz) :: {
	len := if x == 0 then 1 else @tranc(usz, @lg(x));
	idx'mut = len;
	loop {
		idx -= 1;
		buf[idx] = x % 10 + u8("0");
		x /= 10;
		if x == 0 break;
	};

	ret len;
};


