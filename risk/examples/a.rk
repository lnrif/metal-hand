State => struct { ... };
Event => enum { ... };

Events => std.Vec(Event);

next => proc {
	state: &State'mut;
	events: &Events;
	config: &Config;
} -> {
	action: Action;
} :: {
	if config.is-stopped() ret .none;
	if events.is-empty() ret .none;

	state.pos.x += events.x;
	state.pos.y += events.y;

	return .change_position;
};

